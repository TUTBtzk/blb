<?xml version="1.0" encoding="utf-8"?><!--
  账号页从上到下：一行总览 → 账号卡片列表（右下角悬浮按钮添加）。

  为什么最上面要加那一行总览：这一页原来只有一串卡片，「我一共有几个号在跑、手上还剩多少券」
  得自己逐行加。这两个数决定还要不要充值、要不要开新号，必须不点就能看到。
  句子由 ui/AccountOverviewText 算（它要进单测），颜色按 StatusPalette 换三档。

  列表仍然在这里直接铺卡片：每行的名字、一句状态、右侧「切换账号」按钮都由
  AccountsFragment 灌（见 ui/AccountRowText）。底部留 96dp 是给悬浮按钮让位。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            style="@style/Blb.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/overview_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/blb_idle" />

                <TextView
                    android:id="@+id/overview"
                    style="@style/Blb.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/accounts_overview_loading" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片行自带外边距，所以列表只留左右 14dp 和底部给悬浮按钮让位的空间 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        style="@style/Blb.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/accounts_empty"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/accounts_add"
        android:text="@string/accounts_add"
        android:textSize="16sp"
        app:icon="@drawable/ic_action_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
