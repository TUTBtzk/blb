<?xml version="1.0" encoding="utf-8"?><!--
  二级页面的外壳：返回 + 标题 + 一行副标题 + 一整屏内容。

  内容区里三样东西只显示一样（DetailActivity 按页面种类选）：
  · detail_scroll   —— 长说明文字（辅助点击说明）
  · detail_log_scroll —— 运行日志，等宽深底，跟正文彻底分开
  · detail_list     —— 列表（今日状态 / 各账号累计 / 已登记章节）

  另外两样只跟着 detail_list 出现，浮在它上面：
  · detail_scrollbar     —— 常驻快速滚动条，点一下轨道就跳过去
  · detail_scroll_bubble —— 拖动时报「第几章」的气泡

  右边那 14dp 内边距故意不放在根布局上，而是各内容 View 自己让出来：滚动条要一直贴到
  屏幕最右侧，根布局统一吃掉的话它就只能画在卡片里面，压着白底和「点→切号」徽章。

  内容占满整屏正是这一页存在的理由：原来它们分别只有两行、半屏、120dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingStart="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorSecondary" />

        <TextView
            android:id="@+id/detail_title"
            style="@style/Blb.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail_subtitle"
        style="@style/Blb.Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="14dp"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/detail_text"
                style="@style/Blb.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/detail_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_log"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/detail_log"
                style="@style/Blb.Text.Log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <!--
          卡片右边让出 20dp（比左边的 14dp 多 6dp）：滚动条整根挪到屏幕最右侧之后，这 6dp 就是
          滑块和卡片之间那条净空。少了它，滑块又会压回白底上。
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detail_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:paddingEnd="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detail_empty"
            style="@style/Blb.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="14dp"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!--
          拖滚动条时弹出来的气泡：写着「第几章」。90 章一屏 8 行，光看滑块位置猜不出
          拖到哪儿了，所以拖动过程中必须当场把章号说出来。
        -->
        <TextView
            android:id="@+id/detail_scroll_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="?attr/colorSecondary"
            android:elevation="4dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="?attr/colorOnSecondary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!--
          列表右边那根常驻滚动条。整根 44dp 宽是给手指留的命中区，一直延伸到屏幕最右侧
          （命中区必须包含画出来的那一段，否则他照着看见的位置去点会点不着）；画出来的
          滑块离屏幕边留 4dp，左边和卡片之间还有 2dp 净空，压不到白底和「点→切号」徽章。
        -->
        <com.example.blb.ui.FastScrollBar
            android:id="@+id/detail_scrollbar"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:visibility="invisible" />
    </FrameLayout>

</LinearLayout>
