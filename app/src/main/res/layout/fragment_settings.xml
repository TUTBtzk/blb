<?xml version="1.0" encoding="utf-8"?><!--
  设置页把同一类开关放在同一张卡里，目录与核对策略不能埋进系统权限说明。
  原来是一长串裸 Button 和裸 EditText 直接堆在一起，看不出哪几项相关、也看不出边界。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Blb.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_accessibility" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Blb.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/a11y_status"
                    style="@style/Blb.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_a11y"
                    style="@style/Blb.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_open_accessibility" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inspector"
                    style="@style/Blb.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_inspector" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selector_check"
                    style="@style/Blb.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_selector_check" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/export_selectors"
                    style="@style/Blb.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_export_selectors" />

                <TextView
                    android:id="@+id/selector_info"
                    style="@style/Blb.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/Blb.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_section_run" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Blb.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/daily"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_daily" />

                <TextView
                    style="@style/Blb.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/daily_hour"
                    android:text="@string/settings_daily_hour" />

                <EditText
                    android:id="@+id/daily_hour"
                    style="@style/Blb.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    style="@style/Blb.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/spend_cap"
                    android:text="@string/settings_spend_cap" />

                <EditText
                    android:id="@+id/spend_cap"
                    style="@style/Blb.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAutofill="no"
                    android:inputType="number" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/Blb.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_section_subscription" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Blb.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Blb.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/catalog_max_age_hours"
                    android:text="@string/settings_catalog_max_age_hours" />

                <EditText
                    android:id="@+id/catalog_max_age_hours"
                    style="@style/Blb.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAutofill="no"
                    android:inputType="number" />

                <TextView
                    style="@style/Blb.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_catalog_max_age_hint" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/catalog_auto_sync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/settings_catalog_auto_sync" />

                <TextView
                    style="@style/Blb.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_catalog_auto_sync_hint" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/always_detail_audit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/settings_always_detail_audit" />

                <TextView
                    style="@style/Blb.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_always_detail_audit_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Blb.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_section_system" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Blb.Card.Notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/blb_warn_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Blb.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_battery_hint"
                    android:textColor="@color/blb_warn" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/battery"
                    style="@style/Blb.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_battery" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/app_details"
                    style="@style/Blb.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_app_details" />

                <!--
                  2026-09-15：用户报「跑完没有任何提示」。查下来两条系统开关都会把它整条掐掉：
                  没有通知权限 → 「跑完了」那条通知根本不显示；没有 MIUI 的「后台弹出界面」→
                  App 不在前台时那个浮动弹窗起不来。所以这两条要在这里明明白白写出来，
                  并且各给一个直接跳过去的按钮，而不是指望他自己找到那些藏在系统设置里的开关。
                -->
                <TextView
                    android:id="@+id/notify_status"
                    style="@style/Blb.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/blb_warn" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_notification_settings"
                    style="@style/Blb.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_open_notification_settings" />

                <TextView
                    style="@style/Blb.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_popup_permission_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_popup_permission"
                    style="@style/Blb.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_open_popup_permission" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/about"
            style="@style/Blb.Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textAlignment="center" />

    </LinearLayout>
</ScrollView>
