<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_accessibility"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/a11y_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/open_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_accessibility" />

        <Button
            android:id="@+id/inspector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_inspector" />

        <Button
            android:id="@+id/selector_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_selector_check" />

        <Button
            android:id="@+id/export_selectors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_export_selectors" />

        <TextView
            android:id="@+id/selector_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="?android:attr/listDivider" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/dry_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_dry_run" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_daily" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_daily_hour"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/daily_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_max_chapters"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/max_chapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_spend_cap"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/spend_cap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_ads_per_account"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/ads_per_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ad_assist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_ad_assist" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_ad_assist_hint"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ad_jump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_ad_jump" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_ad_jump_hint"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_battery_hint"
            android:textSize="12sp" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_battery" />

        <Button
            android:id="@+id/app_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_app_details" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
