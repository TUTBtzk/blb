<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      配色只在这里定义，界面里一律用 ?attr（themes.xml 把它们接到 Material 3 的角色上），
      这样 values-night 换一套值就能整体变暗，不用改任何布局。

      黄色主题，取自软件图标那只奶油底菠萝包。黄有个绕不过去的坎：亮黄当文字色
      在浅底上根本读不出来（对比不到 2:1）。所以这里把黄拆成两个角色，界面里
      不许混用：

      · colorPrimary  = 亮蜜黄，只做「填充的块」—— 主按钮底、FAB、开关轨道。
        配的字是近黑棕（onPrimary），对比 8.7:1，隔着屏幕也看得清。
      · colorSecondary = 深琥珀，只做「着色的字和线」—— 分区标题、tab 选中、
        小圆点、描边按钮的字。对白底 7.6:1，过 AA 还有余量。

      中性色全部偏暖（奶油底＋纯白卡片），跟图标一个调子；卡片是纯白，
      浮在奶油背景上，层级不靠阴影也看得出来。
    -->
    <color name="blb_primary">#F5B60D</color>
    <color name="blb_on_primary">#241A00</color>
    <color name="blb_primary_container">#FFE7A8</color>
    <color name="blb_on_primary_container">#2E1F00</color>
    <color name="blb_secondary">#7A4E00</color>
    <color name="blb_on_secondary">#FFFFFFFF</color>
    <color name="blb_secondary_container">#FBECC4</color>
    <color name="blb_on_secondary_container">#3D2900</color>

    <color name="blb_background">#FBF5E8</color>
    <color name="blb_surface">#FDF9F0</color>
    <color name="blb_surface_container">#FFFFFFFF</color>
    <color name="blb_on_surface">#201B10</color>
    <color name="blb_on_surface_variant">#57503F</color>
    <color name="blb_outline">#8A8069</color>
    <color name="blb_outline_variant">#E4DAC4</color>

    <color name="blb_error">#C22B2B</color>
    <color name="blb_on_error">#FFFFFFFF</color>
    <color name="blb_error_container">#FBE0E0</color>
    <color name="blb_on_error_container">#480C0C</color>

    <!--
      语义色：一眼看出每个账号今天到底怎么样。深色是文字/色条，浅色是徽章底。
      「等一下」那档从原来的琥珀改成橙红 —— 在黄主题里琥珀和主色几乎分不开，
      而这一档（验证码、缺密码）恰恰是最需要一眼认出来的。
    -->
    <color name="blb_ok">#12794A</color>
    <color name="blb_ok_container">#D7F0E0</color>
    <color name="blb_warn">#B24A06</color>
    <color name="blb_warn_container">#FFDFC4</color>
    <color name="blb_fail">#C22B2B</color>
    <color name="blb_fail_container">#FBE0E0</color>
    <color name="blb_skip">#5D5747</color>
    <color name="blb_skip_container">#EAE3D3</color>
    <color name="blb_idle">#8D8571</color>
    <color name="blb_idle_container">#F0EADB</color>

    <!-- 运行日志那块：等宽字＋深底，跟正文明显分开，扫日志时不会跟状态混在一起 -->
    <color name="blb_log_surface">#1E1810</color>
    <color name="blb_log_text">#E4D9C2</color>
</resources>
