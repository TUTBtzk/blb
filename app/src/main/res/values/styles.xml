<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      界面里所有反复出现的外观都收在这里，布局只引 style，不再各写一遍 textSize。
      改一处就能全局生效 —— 比如哪天觉得字还不够大，只动 Blb.Text.* 这几条。
    -->

    <!-- ==== 卡片 ==== -->
    <style name="Blb.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- 列表行：内边距交给行内布局，另外要有点按反馈（账号页可点可长按） -->
    <style name="Blb.Card.Row" parent="Blb.Card">
        <item name="cardCornerRadius">18dp</item>
        <item name="contentPadding">0dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- 带语义色的提示条（暂停、建议）：底色和描边由布局按语义指定 -->
    <style name="Blb.Card.Notice" parent="Blb.Card">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">14dp</item>
    </style>

    <!-- ==== 按钮：主操作 56dp 高、17sp，隔着屏幕也看得清按的是哪个 ==== -->
    <style name="Blb.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">22dp</item>
    </style>

    <style name="Blb.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <!--
      描边按钮：Material 默认拿 colorPrimary 当文字和描边色，而这套主题的 primary 是
      亮蜜黄 —— 白底上亮黄字等于没写。所以这里显式换成深琥珀（colorSecondary）。
    -->
    <style name="Blb.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:textColor">@color/btn_outlined_fg</item>
        <item name="iconTint">@color/btn_outlined_fg</item>
        <item name="strokeColor">@color/btn_outlined_stroke</item>
    </style>
    <!-- ==== 文字 ==== -->
    <!-- 区块标题：小号大写感的标签，用深琥珀（不是亮黄，那个在浅底上读不出来） -->
    <style name="Blb.Text.Section" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <style name="Blb.Text.Title" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Blb.Text.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 说明文字：比正文小一号、颜色淡一档，但仍然过 AA 对比度 -->
    <style name="Blb.Text.Hint" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 列表行的两行文字 -->
    <style name="Blb.Text.Line1" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Blb.Text.Line2" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 状态徽章：底色和文字色在代码里按状态换（见 StatusStyle） -->
    <style name="Blb.Badge" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- 运行日志：等宽＋深底，跟正文彻底分开，滚长了也不会跟状态混起来 -->
    <style name="Blb.Text.Log" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/blb_log_text</item>
    </style>

    <!-- ==== 输入与开关 ==== -->
    <!-- 设置页那堆裸 EditText：给个描边圆角底，别再是一条系统下划线 -->
    <style name="Blb.Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOutline</item>
    </style>

    <style name="Blb.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- ==== 容器控件 ==== -->
    <style name="Blb.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemActiveIndicatorStyle">@style/Blb.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemTextAppearanceActive">@style/Blb.BottomNav.Label</item>
        <item name="itemTextAppearanceInactive">@style/Blb.BottomNav.Label</item>
    </style>

    <style name="Blb.BottomNav.Indicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">72dp</item>
        <item name="android:height">36dp</item>
    </style>

    <!-- tab 文字比默认大一点：这几个字是「我在哪一页」的唯一提示。 -->
    <style name="Blb.BottomNav.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Blb.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/Blb.Shape.Fab</item>
    </style>

    <!-- 账号页那颗带文字的 FAB：浅蜜黄底＋深棕字（对比 11:1），圆角跟卡片一个家族 -->
    <style name="Blb.Fab.Extended"
        parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="shapeAppearanceOverlay">@style/Blb.Shape.Fab</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconSize">22dp</item>
    </style>

    <style name="Blb.Shape.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Blb.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Blb.Shape.Dialog</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Blb.Dialog.Body</item>
    </style>

    <style name="Blb.Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Blb.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

</resources>
