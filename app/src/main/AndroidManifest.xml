<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 普通安装不会得到这项权限。照护者安装后用 adb pm grant 授予一次，应用才能在
         MIUI 从最近任务划掉时把被系统清除的无障碍条目自动补回来。
         这是可由 ADB 授予的 development 权限；AccessibilityAccess 每次写入前都检查授权，
         此处仅排除 Lint 对普通应用自动获取系统权限的通用提示。 -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 返回看门狗用准点闹钟防止回程中断：既有真机记录表明第三方界面占着前台时，
         MIUI 可能冻结或杀掉进程（stop … due to SwipeUpClean）。
         2026-09-14 精简日常流程仍保留公共返回能力，见 ReturnWatchdog。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 整趟任务期间把屏幕点着（AutomationService.acquireScreenLock）：无障碍的点击只对亮着的
         屏幕有效，2026-08-23 那趟就是跑到第 5 个号时屏幕自己睡了，后面全报「拉不起菠萝包」。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ 的包可见性：没有这段就拿不到菠萝包的启动 Intent。 -->
    <queries>
        <package android:name="com.sfacg" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blb自动签到"
        tools:ignore="DataExtractionRules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.InspectorActivity"
            android:exported="false"
            android:label="@string/settings_inspector" />

        <!-- 二级页面：签到页和订阅页上五处「信息多、窗口小」的东西各占一整屏。
             一个 Activity 靠 intent extra "page" 分派五种内容，见 DetailActivity。 -->
        <activity
            android:name=".ui.DetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 一趟跑完盖在屏幕正中的结论。使用者手指动不了、拉不开通知栏，所以这条结论
             必须自己弹出来（见 DoneDialogActivity）。singleTop：连着跑两趟只换内容，
             不叠第二个弹窗；excludeFromRecents：它不是一页界面，别留在多任务里。 -->
        <activity
            android:name=".ui.DoneDialogActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Blb.Done" />


        <!-- 唯一能读写菠萝包界面的组件，只在你手动开启无障碍后生效。 -->
        <service
            android:name=".auto.BlbAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".auto.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="按顺序为多个账号执行签到，需要在无障碍服务驱动下持续运行到队列结束" />
        </service>
        <!-- 落地页上的「带你回来」闹钟。不导出，只由本 App 自己上的闹钟触发。 -->
        <receiver
            android:name=".auto.ReturnWatchdog"
            android:exported="false" />

        <receiver
            android:name=".auto.AccessibilityRecoveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
