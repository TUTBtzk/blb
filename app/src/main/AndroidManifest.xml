<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 按下广告里的跳转键之后，用一个准点闹钟保证「按返回把人带回来」这一下一定会发生：
         实测第三方落地页占着前台时，系统会把我们冻住甚至杀掉（MIUI: stop … due to SwipeUpClean），
         那时候只有闹钟能把进程解冻／重新拉起来。见 ReturnWatchdog。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 11+ 的包可见性：没有这段就拿不到菠萝包的启动 Intent。 -->
    <queries>
        <package android:name="com.sfacg" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blb自动签到"
        tools:ignore="DataExtractionRules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.InspectorActivity"
            android:exported="false"
            android:label="@string/settings_inspector" />

        <!-- 唯一能读写菠萝包界面的组件，只在你手动开启无障碍后生效。 -->
        <service
            android:name=".auto.BlbAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".auto.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="按顺序为多个账号执行签到，需要在无障碍服务驱动下持续运行到队列结束" />
        </service>
        <!-- 落地页上的「带你回来」闹钟。不导出，只由本 App 自己上的闹钟触发。 -->
        <receiver
            android:name=".auto.ReturnWatchdog"
            android:exported="false" />

    </application>

</manifest>
